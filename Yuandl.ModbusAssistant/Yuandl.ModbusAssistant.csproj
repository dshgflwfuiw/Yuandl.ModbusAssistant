<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Yuandl.ModbusAssistant</AssemblyName>
    <RootNamespace>Yuandl.ModbusAssistant</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Yuandl Modbus Assistant</Product>
    <Company>Yuandl</Company>
    <Authors>Yuandl</Authors>
    <Description>工业协议与 Modbus 调试工作站（支持串口、TCP/UDP、内置 Modbus 从站仿真、多通道实时示波器与报文分析）</Description>
    <Copyright>Copyright © Yuandl</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Yuandl.ThemeUI" Version="2.0.7" />
  </ItemGroup>

</Project>
