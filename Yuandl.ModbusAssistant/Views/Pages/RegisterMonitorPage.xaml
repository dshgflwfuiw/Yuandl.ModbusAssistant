<Page x:Class="Yuandl.ModbusAssistant.Views.Pages.RegisterMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
      xmlns:pages="clr-namespace:Yuandl.ModbusAssistant.ViewModels.Pages"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance pages:RegisterMonitorViewModel}" Title="寄存器监视">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <ui:TextBlock Text="寄存器监视中心" FontTypography="Title" Margin="0,0,0,6" />
            <ui:TextBlock Text="支持手动读取、定时轮询、端序转换、缩放和寄存器备注。" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="0,0,0,16" />
            <ui:Card Padding="16">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <TextBox Width="90" ToolTip="起始地址" Text="{Binding ViewModel.StartAddress, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <TextBox Width="90" ToolTip="寄存器数量" Text="{Binding ViewModel.RegisterCount, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <TextBox Width="90" ToolTip="刷新周期(ms)" Text="{Binding ViewModel.PollIntervalMs, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <ComboBox Width="130" ItemsSource="{Binding ViewModel.DataTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedDataType, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <ComboBox Width="130" ItemsSource="{Binding ViewModel.ByteOrderOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedByteOrder, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <TextBox Width="80" ToolTip="缩放" Text="{Binding ViewModel.Scale, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <ui:Button Content="读取一次" Command="{Binding ViewModel.ReadOnceCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <ui:Button Content="开始/停止轮询" Command="{Binding ViewModel.TogglePollingCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </WrapPanel>
                    <ui:TextBlock Text="{Binding ViewModel.StatusText, RelativeSource={RelativeSource AncestorType=Page}}" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding ViewModel.Rows, RelativeSource={RelativeSource AncestorType=Page}}" MinHeight="260">
                        <ListView.View><GridView>
                            <GridViewColumn Header="地址" DisplayMemberBinding="{Binding Address}" Width="100" />
                            <GridViewColumn Header="原始值" DisplayMemberBinding="{Binding RawValue}" Width="100" />
                            <GridViewColumn Header="解析值" DisplayMemberBinding="{Binding Value}" Width="180" />
                            <GridViewColumn Header="备注" DisplayMemberBinding="{Binding Note}" Width="220" />
                        </GridView></ListView.View>
                    </ListView>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
