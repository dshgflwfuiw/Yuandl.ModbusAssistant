<Page x:Class="Yuandl.ModbusAssistant.Views.Pages.PacketAnalysisPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml" xmlns:pages="clr-namespace:Yuandl.ModbusAssistant.ViewModels.Pages" mc:Ignorable="d" d:DataContext="{d:DesignInstance pages:PacketAnalysisViewModel}" Title="报文分析">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
  <ui:TextBlock Text="报文分析" FontTypography="Title" Margin="0,0,0,6" /><ui:TextBlock Text="解析 HEX 报文，关联功能码、校验结果和 Modbus 异常。" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="0,0,0,16" />
  <ui:Card Padding="16"><StackPanel>
   <WrapPanel><ComboBox Width="140" ItemsSource="{Binding ViewModel.TransportOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedTransport, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><TextBox Width="500" Text="{Binding ViewModel.InputHex, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" /><ui:Button Content="分析" Command="{Binding ViewModel.AnalyzeCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><ui:Button Content="清空" Command="{Binding ViewModel.ClearCommand, RelativeSource={RelativeSource AncestorType=Page}}" /></WrapPanel>
   <ui:TextBlock Text="{Binding ViewModel.AnalysisResult, RelativeSource={RelativeSource AncestorType=Page}}" TextWrapping="Wrap" Margin="0,12,0,8" />
   <ListView ItemsSource="{Binding ViewModel.Entries, RelativeSource={RelativeSource AncestorType=Page}}" MinHeight="300"><ListView.View><GridView><GridViewColumn Header="时间" DisplayMemberBinding="{Binding Timestamp}" Width="150" /><GridViewColumn Header="方向" DisplayMemberBinding="{Binding Direction}" Width="70" /><GridViewColumn Header="HEX" DisplayMemberBinding="{Binding Hex}" Width="360" /><GridViewColumn Header="结果" DisplayMemberBinding="{Binding Result}" Width="360" /></GridView></ListView.View></ListView>
  </StackPanel></ui:Card>
 </StackPanel></ScrollViewer>
</Page>
