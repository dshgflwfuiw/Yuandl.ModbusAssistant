<Page x:Class="Yuandl.ModbusAssistant.Views.Pages.DeviceManagementPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml" xmlns:pages="clr-namespace:Yuandl.ModbusAssistant.ViewModels.Pages" mc:Ignorable="d" d:DataContext="{d:DesignInstance pages:DeviceManagementViewModel}" Title="设备管理">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><ui:TextBlock Text="设备管理" FontTypography="Title" Margin="0,0,0,6" /><ui:TextBlock Text="保存常用通讯设备配置，启动调试时快速复用。" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="0,0,0,16" />
  <ui:Card Padding="16"><StackPanel><WrapPanel Margin="0,0,0,12"><TextBox Width="130" ToolTip="名称" Text="{Binding ViewModel.NewProfileName, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><TextBox Width="130" ToolTip="协议" Text="{Binding ViewModel.NewProtocol, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><TextBox Width="180" ToolTip="地址" Text="{Binding ViewModel.NewEndpoint, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><TextBox Width="70" ToolTip="站号" Text="{Binding ViewModel.NewStationId, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><ui:Button Content="添加" Command="{Binding ViewModel.AddProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}" /></WrapPanel>
   <WrapPanel Margin="0,0,0,8"><ui:Button Content="保存" Command="{Binding ViewModel.SaveProfilesCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><ui:Button Content="重新加载" Command="{Binding ViewModel.LoadProfilesCommand, RelativeSource={RelativeSource AncestorType=Page}}" /></WrapPanel>
   <ListView ItemsSource="{Binding ViewModel.Profiles, RelativeSource={RelativeSource AncestorType=Page}}" MinHeight="260"><ListView.View><GridView><GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="180" /><GridViewColumn Header="协议" DisplayMemberBinding="{Binding Protocol}" Width="140" /><GridViewColumn Header="地址" DisplayMemberBinding="{Binding Endpoint}" Width="220" /><GridViewColumn Header="站号" DisplayMemberBinding="{Binding StationId}" Width="80" /></GridView></ListView.View></ListView>
   <ui:TextBlock Text="{Binding ViewModel.StatusText, RelativeSource={RelativeSource AncestorType=Page}}" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="0,8,0,0" />
  </StackPanel></ui:Card></StackPanel></ScrollViewer>
</Page>
