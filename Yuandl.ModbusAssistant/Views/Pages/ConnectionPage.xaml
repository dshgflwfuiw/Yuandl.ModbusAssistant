<Page x:Class="Yuandl.ModbusAssistant.Views.Pages.ConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
      xmlns:pages="clr-namespace:Yuandl.ModbusAssistant.ViewModels.Pages"
      xmlns:converters="clr-namespace:Yuandl.ModbusAssistant.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      d:DataContext="{d:DesignInstance pages:ConnectionViewModel}"
      Title="通讯连接">

    <Page.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="PageScrollViewer"
                  CanContentScroll="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- 头部标题说明 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- 核心参数配置卡片 -->
                <RowDefinition Height="Auto" />
                <!-- 连接控制与状态反馈 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. 标题区 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:TextBlock Text="通讯链路管理" FontTypography="Title" Margin="0,0,0,6" />
                <ui:TextBlock Text="配置串行端口 (RS232/RS485)、TCP 客户端与 UDP 通讯链路，支持自动重连与状态监视"
                              Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
            </StackPanel>

            <!-- 2. 主配置区域 -->
            <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <!-- 介质选择 -->
                    <ui:TextBlock Text="通讯介质类型" FontTypography="Subtitle" Margin="0,0,0,12" />
                    <ComboBox SelectedIndex="{Binding ViewModel.SelectedCommTypeIndex, RelativeSource={RelativeSource AncestorType=Page}}"
                              IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                              Width="260" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <ComboBoxItem Content="RS232 / RS485 串行端口" />
                        <ComboBoxItem Content="TCP Client (客户端)" />
                        <ComboBoxItem Content="UDP 通讯 (无连接)" />
                    </ComboBox>

                    <Separator Margin="0,0,0,16" />

                    <!-- ====== 串口参数界面 (Index = 0) ====== -->
                    <StackPanel Visibility="{Binding ViewModel.SelectedCommTypeIndex, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                        <ui:TextBlock Text="串口参数设定" FontTypography="BodyStrong" Margin="0,0,0,12" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- COM 端口 -->
                            <StackPanel Width="220" Margin="0,0,16,12">
                                <ui:TextBlock Text="COM 端口" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ViewModel.AvailablePorts, RelativeSource={RelativeSource AncestorType=Page}}"
                                              SelectedItem="{Binding ViewModel.SelectedPort, RelativeSource={RelativeSource AncestorType=Page}}"
                                              IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                                    <ui:Button Grid.Column="1" Margin="6,0,0,0"
                                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                                               ToolTip="刷新可用串口"
                                               Command="{Binding ViewModel.RefreshSerialPortsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                                </Grid>
                            </StackPanel>

                            <!-- 波特率 -->
                            <StackPanel Width="180" Margin="0,0,16,12">
                                <ui:TextBlock Text="波特率 (Baud Rate)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <ComboBox ItemsSource="{Binding ViewModel.BaudRateOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedItem="{Binding ViewModel.SelectedBaudRate, RelativeSource={RelativeSource AncestorType=Page}}"
                                          IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <!-- 数据位 -->
                            <StackPanel Width="140" Margin="0,0,16,12">
                                <ui:TextBlock Text="数据位 (Data Bits)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <ComboBox ItemsSource="{Binding ViewModel.DataBitsOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedItem="{Binding ViewModel.DataBits, RelativeSource={RelativeSource AncestorType=Page}}"
                                          IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <!-- 校验位 -->
                            <StackPanel Width="160" Margin="0,0,16,12">
                                <ui:TextBlock Text="校验位 (Parity)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <ComboBox ItemsSource="{Binding ViewModel.ParityOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedItem="{Binding ViewModel.SelectedParity, RelativeSource={RelativeSource AncestorType=Page}}"
                                          IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <!-- 停止位 -->
                            <StackPanel Width="140" Margin="0,0,16,12">
                                <ui:TextBlock Text="停止位 (Stop Bits)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <ComboBox ItemsSource="{Binding ViewModel.StopBitsOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedItem="{Binding ViewModel.SelectedStopBits, RelativeSource={RelativeSource AncestorType=Page}}"
                                          IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- 控制信号 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox Content="启用 DTR (数据终端就绪)"
                                      IsChecked="{Binding ViewModel.DtrEnable, RelativeSource={RelativeSource AncestorType=Page}}"
                                      IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                                      Margin="0,0,24,0" />
                            <CheckBox Content="启用 RTS (请求发送 - RS485流控)"
                                      IsChecked="{Binding ViewModel.RtsEnable, RelativeSource={RelativeSource AncestorType=Page}}"
                                      IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ====== TCP Client 参数界面 (Index = 1) ====== -->
                    <StackPanel Visibility="{Binding ViewModel.SelectedCommTypeIndex, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                        <ui:TextBlock Text="TCP 客户端参数设定" FontTypography="BodyStrong" Margin="0,0,0,12" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel Width="240" Margin="0,0,16,12">
                                <ui:TextBlock Text="目标主机 IP / 域名" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <TextBox Text="{Binding ViewModel.TcpHost, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <StackPanel Width="160" Margin="0,0,16,12">
                                <ui:TextBlock Text="目标端口 (Port)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <TextBox Text="{Binding ViewModel.TcpPort, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <StackPanel Width="180" Margin="0,0,16,12">
                                <ui:TextBlock Text="连接超时时间 (ms)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <TextBox Text="{Binding ViewModel.ConnectTimeoutMs, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>
                        </WrapPanel>

                        <CheckBox Content="开启异常断线自动重连 (3秒间隔)"
                                  IsChecked="{Binding ViewModel.AutoReconnect, RelativeSource={RelativeSource AncestorType=Page}}"
                                  IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                                  Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- ====== UDP 参数界面 (Index = 2) ====== -->
                    <StackPanel Visibility="{Binding ViewModel.SelectedCommTypeIndex, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                        <ui:TextBlock Text="UDP 通讯参数设定" FontTypography="BodyStrong" Margin="0,0,0,12" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <StackPanel Width="240" Margin="0,0,16,12">
                                <ui:TextBlock Text="远程目标主机 IP" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <TextBox Text="{Binding ViewModel.UdpRemoteHost, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <StackPanel Width="160" Margin="0,0,16,12">
                                <ui:TextBlock Text="远程端口 (Port)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <TextBox Text="{Binding ViewModel.UdpRemotePort, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <StackPanel Width="200" Margin="0,0,16,12">
                                <ui:TextBlock Text="本地绑定端口 (0为自动)" Margin="0,0,0,6" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                                <TextBox Text="{Binding ViewModel.UdpLocalPort, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- 3. 操作控制与状态呈现 -->
            <ui:Card Grid.Row="2" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态说明 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:TextBlock Text="当前状态: " FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{Binding ViewModel.ConnectionStateText, RelativeSource={RelativeSource AncestorType=Page}}"
                                          FontTypography="BodyStrong">
                                <ui:TextBlock.Style>
                                    <Style TargetType="ui:TextBlock">
                                        <Setter Property="Foreground" Value="#8A8A8A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                <Setter Property="Foreground" Value="#107C41" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>
                        </StackPanel>
                        <ui:TextBlock Text="连接成功后，可在 Modbus 调试、无协议调试及寄存器监视中无缝协同通讯"
                                      Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                    </StackPanel>

                    <!-- 动作按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 连接按钮 -->
                        <ui:Button Content="建立连接"
                                   Icon="{ui:SymbolIcon PlugConnected24}"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.ConnectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}"
                                   MinWidth="120" Height="36" Margin="0,0,12,0" />

                        <!-- 断开按钮 -->
                        <ui:Button Content="断开连接"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Appearance="Error"
                                   Command="{Binding ViewModel.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   IsEnabled="{Binding ViewModel.IsConnected, RelativeSource={RelativeSource AncestorType=Page}}"
                                   MinWidth="120" Height="36" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="3" Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <ui:TextBlock Text="Modbus TCP 服务器模式" FontTypography="Subtitle" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,10">
                        <TextBox Width="120" ToolTip="监听端口" Text="{Binding ViewModel.ServerPort, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        <TextBox Width="100" ToolTip="站号" Text="{Binding ViewModel.ServerStation, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
                        <ui:Button Content="启动服务器" Command="{Binding ViewModel.StartServerCommand, RelativeSource={RelativeSource AncestorType=Page}}" IsEnabled="{Binding ViewModel.IsServerRunning, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBooleanConverter}}" Margin="0,0,8,0" />
                        <ui:Button Content="停止服务器" Command="{Binding ViewModel.StopServerCommand, RelativeSource={RelativeSource AncestorType=Page}}" IsEnabled="{Binding ViewModel.IsServerRunning, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </WrapPanel>
                    <ui:TextBlock Text="{Binding ViewModel.ServerStatusText, RelativeSource={RelativeSource AncestorType=Page}}" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Row="4" Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <ui:TextBlock Text="服务器数据区配置" FontTypography="Subtitle" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <ComboBox Width="150" ToolTip="数据区" ItemsSource="{Binding ViewModel.RegisterAreaOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedRegisterArea, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <TextBox Width="90" ToolTip="起始地址" Text="{Binding ViewModel.ServerRegisterAddress, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <ComboBox Width="130" ToolTip="数据类型" ItemsSource="{Binding ViewModel.RegisterDataTypeOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedRegisterDataType, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <ComboBox Width="130" ToolTip="字节序" ItemsSource="{Binding ViewModel.RegisterByteOrderOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedRegisterByteOrder, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <TextBox Width="110" ToolTip="初始值（Bit 使用 true/false）" Text="{Binding ViewModel.ServerRegisterValue, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <TextBox Width="150" ToolTip="备注" Text="{Binding ViewModel.ServerRegisterNote, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <ui:Button Content="添加/更新" Command="{Binding ViewModel.CreateServerRegisterCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <ui:Button Content="删除所选" Command="{Binding ViewModel.RemoveServerRegisterCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding ViewModel.SelectedServerRegister, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button Content="导入 JSON" Command="{Binding ViewModel.ImportServerConfigurationCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
                        <ui:Button Content="导出 JSON" Command="{Binding ViewModel.ExportServerConfigurationCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </WrapPanel>
                    <ListView x:Name="ServerRegistersList"
                              ItemsSource="{Binding ViewModel.ServerRegisters, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.SelectedServerRegister, RelativeSource={RelativeSource AncestorType=Page}}"
                              PreviewMouseWheel="ServerRegistersList_PreviewMouseWheel"
                              Height="220">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="区域" DisplayMemberBinding="{Binding Area}" Width="130" />
                                <GridViewColumn Header="地址" DisplayMemberBinding="{Binding Address}" Width="70" />
                                <GridViewColumn Header="类型" DisplayMemberBinding="{Binding DataType}" Width="80" />
                                <GridViewColumn Header="字节序" DisplayMemberBinding="{Binding ByteOrder}" Width="90" />
                                <GridViewColumn Header="长度" DisplayMemberBinding="{Binding Width}" Width="50" />
                                <GridViewColumn Header="初始值" DisplayMemberBinding="{Binding InitialValue}" Width="100" />
                                <GridViewColumn Header="备注" DisplayMemberBinding="{Binding Note}" Width="160" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>
