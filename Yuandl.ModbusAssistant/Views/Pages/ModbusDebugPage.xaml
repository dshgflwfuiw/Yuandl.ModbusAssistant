<Page x:Class="Yuandl.ModbusAssistant.Views.Pages.ModbusDebugPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml" xmlns:pages="clr-namespace:Yuandl.ModbusAssistant.ViewModels.Pages" mc:Ignorable="d" d:DataContext="{d:DesignInstance pages:ModbusDebugViewModel}" Title="Modbus 调试">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
  <ui:TextBlock Text="Modbus 调试" FontTypography="Title" Margin="0,0,0,6" />
  <ui:TextBlock Text="自动生成 RTU、ASCII、TCP 请求，校验 CRC/LRC 并解析响应。" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="0,0,0,16" />
  <ui:Card Padding="16"><StackPanel>
   <WrapPanel Margin="0,0,0,12">
    <TextBox Width="70" ToolTip="从站地址" Text="{Binding ViewModel.SlaveId, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
    <ComboBox Width="170" ItemsSource="{Binding ViewModel.TransportOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedTransport, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
    <ComboBox Width="220" ItemsSource="{Binding ViewModel.FunctionCodeOptions, RelativeSource={RelativeSource AncestorType=Page}}" SelectedItem="{Binding ViewModel.SelectedFunctionCode, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
    <TextBox Width="90" ToolTip="起始地址" Text="{Binding ViewModel.StartAddress, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
    <TextBox Width="90" ToolTip="数量" Text="{Binding ViewModel.Quantity, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" />
    <TextBox Width="90" ToolTip="写入值" Text="{Binding ViewModel.WriteValue, RelativeSource={RelativeSource AncestorType=Page}}" />
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8"><ui:Button Content="生成请求" Command="{Binding ViewModel.BuildRequestCommand, RelativeSource={RelativeSource AncestorType=Page}}" Margin="0,0,8,0" /><ui:Button Content="发送请求" Appearance="Primary" Command="{Binding ViewModel.SendCommand, RelativeSource={RelativeSource AncestorType=Page}}" /></WrapPanel>
   <ui:TextBlock Text="请求 HEX" FontTypography="BodyStrong" /><TextBox Text="{Binding ViewModel.RequestHex, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
   <ui:TextBlock Text="响应 HEX" FontTypography="BodyStrong" /><TextBox Text="{Binding ViewModel.ResponseHex, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
   <ui:TextBlock Text="{Binding ViewModel.StatusText, RelativeSource={RelativeSource AncestorType=Page}}" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
   <ui:TextBlock Text="{Binding ViewModel.ResultText, RelativeSource={RelativeSource AncestorType=Page}}" TextWrapping="Wrap" Margin="0,6,0,0" />
  </StackPanel></ui:Card>
 </StackPanel></ScrollViewer>
</Page>
