<Page x:Class="Yuandl.ModbusAssistant.Views.Pages.RawDebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
      xmlns:pages="clr-namespace:Yuandl.ModbusAssistant.ViewModels.Pages"
      xmlns:raw="clr-namespace:Yuandl.ModbusAssistant.Models.Raw"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      d:DataContext="{d:DesignInstance pages:RawDebugViewModel}"
      Title="无协议调试">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 顶部控制工具栏 -->
            <RowDefinition Height="Auto" />
            <!-- 中部报文交互流展示区 -->
            <RowDefinition Height="*" />
            <!-- 底部发送控制台 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部控制栏卡片 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：接收配置与控制 -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="接收格式:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                    <ComboBox ItemsSource="{Binding ViewModel.EncodingOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.ReceiveEncoding, RelativeSource={RelativeSource AncestorType=Page}}"
                              Width="100" Margin="0,0,16,0" />

                    <CheckBox Content="暂停接收"
                              IsChecked="{Binding ViewModel.IsPauseReceive, RelativeSource={RelativeSource AncestorType=Page}}"
                              Margin="0,0,16,0" VerticalAlignment="Center" />

                    <CheckBox Content="自动滚动"
                              IsChecked="{Binding ViewModel.IsAutoScroll, RelativeSource={RelativeSource AncestorType=Page}}"
                              Margin="0,0,16,0" VerticalAlignment="Center" />

                    <CheckBox Content="显示时间戳"
                              IsChecked="{Binding ViewModel.ShowTimestamp, RelativeSource={RelativeSource AncestorType=Page}}"
                              Margin="0,0,16,0" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ui:TextBlock Text="TX: " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                        <ui:TextBlock Text="{Binding ViewModel.TotalTxPackets, RelativeSource={RelativeSource AncestorType=Page}}" FontWeight="SemiBold" />
                        <ui:TextBlock Text="帧 / " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                        <ui:TextBlock Text="{Binding ViewModel.TotalTxBytes, RelativeSource={RelativeSource AncestorType=Page}}" FontWeight="SemiBold" />
                        <ui:TextBlock Text="B   |   RX: " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" Margin="8,0,0,0" />
                        <ui:TextBlock Text="{Binding ViewModel.TotalRxPackets, RelativeSource={RelativeSource AncestorType=Page}}" FontWeight="SemiBold" />
                        <ui:TextBlock Text="帧 / " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                        <ui:TextBlock Text="{Binding ViewModel.TotalRxBytes, RelativeSource={RelativeSource AncestorType=Page}}" FontWeight="SemiBold" />
                        <ui:TextBlock Text="B" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                    </StackPanel>
                </WrapPanel>

                <!-- 右侧：清屏按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="清空记录"
                               Icon="{ui:SymbolIcon Broom24}"
                               Command="{Binding ViewModel.ClearMessagesCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 2. 中部数据流展示区 -->
        <Border Grid.Row="1" Margin="0,0,0,12"
                Background="{ui:ThemeResource ControlFillSecondaryColorBrush}"
                BorderBrush="{ui:ThemeResource ControlBorderColorBrush}"
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="MessagesList"
                     ItemsSource="{Binding ViewModel.Messages, RelativeSource={RelativeSource AncestorType=Page}}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type raw:RawMessageItem}">
                        <Border Margin="2,3" Padding="8,6" Background="{ui:ThemeResource ApplicationFillBrush}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 时间戳 -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- 方向标签 -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- 数据长度 -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- 真实报文数据 -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 时间戳 -->
                                <ui:TextBlock Grid.Column="0"
                                              Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}"
                                              Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}"
                                              FontFamily="Consolas" FontSize="12"
                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                              Visibility="{Binding DataContext.ShowTimestamp, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- 方向标签 -->
                                <Border Grid.Column="1" Padding="6,2" Margin="0,0,10,0" CornerRadius="3" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A0078D4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTx}" Value="True">
                                                    <Setter Property="Background" Value="#22107C41" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DirectionText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0078D4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTx}" Value="True">
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- 长度 -->
                                <ui:TextBlock Grid.Column="2"
                                              Text="{Binding Length, StringFormat='({0} B)'}"
                                              Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}"
                                              FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <!-- 报文正文：等宽字体，支持折行 -->
                                <TextBox Grid.Column="3"
                                         Text="{Binding FormattedText, Mode=OneWay}"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Foreground="{ui:ThemeResource ApplicationTextColorBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 3. 底部发送控制台 -->
        <ui:Card Grid.Row="2" Padding="16,14">
            <StackPanel>
                <!-- 控制行：编码格式、结束符、定时循环、历史 -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <ui:TextBlock Text="发送格式:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                        <ComboBox ItemsSource="{Binding ViewModel.EncodingOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                  SelectedItem="{Binding ViewModel.SendEncoding, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Width="100" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <ui:TextBlock Text="追加结束符:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                        <ComboBox ItemsSource="{Binding ViewModel.DelimiterOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                  SelectedItem="{Binding ViewModel.SelectedDelimiter, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Width="100" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                        <CheckBox Content="定时循环发送"
                                  IsChecked="{Binding ViewModel.IsLoopSend, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Command="{Binding ViewModel.ToggleLoopSendCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ViewModel.LoopIntervalMs, RelativeSource={RelativeSource AncestorType=Page}}"
                                 Width="60" TextAlignment="Center" VerticalAlignment="Center" />
                        <ui:TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:TextBlock Text="发送历史:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                        <ComboBox ItemsSource="{Binding ViewModel.SendHistory, RelativeSource={RelativeSource AncestorType=Page}}"
                                  SelectedItem="{Binding ViewModel.SelectedHistoryItem, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Width="200" />
                        <ui:Button Margin="4,0,0,0"
                                   Icon="{ui:SymbolIcon Delete20}"
                                   ToolTip="清空历史"
                                   Command="{Binding ViewModel.ClearHistoryCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </StackPanel>
                </WrapPanel>

                <!-- 发送输入与主按钮 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding ViewModel.InputText, RelativeSource={RelativeSource AncestorType=Page}, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="14"
                             Height="64"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,12,0" />

                    <ui:Button Grid.Column="1"
                               Content="发送数据"
                               Icon="{ui:SymbolIcon Send24}"
                               Appearance="Primary"
                               Width="120"
                               Height="64"
                               Command="{Binding ViewModel.SendCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                </Grid>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
