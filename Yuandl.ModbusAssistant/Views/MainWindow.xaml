<ui:FluentWindow x:Class="Yuandl.ModbusAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.yuandl.cn/xamltheme/2024/xaml"
        xmlns:vm="clr-namespace:Yuandl.ModbusAssistant.ViewModels"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        ui:Design.Background="{ui:ThemeResource ApplicationFillBrush}"
        ui:Design.Foreground="{ui:ThemeResource ApplicationTextColorBrush}"
        Background="{ui:ThemeResource ApplicationFillBrush}"
        Foreground="{ui:ThemeResource ApplicationTextColorBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="620"
        Title="{Binding WindowTitle}"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 沉浸式标题栏 -->
            <RowDefinition Height="40" />
            <!-- 主内容区域：侧边导航 + 视图页 -->
            <RowDefinition Height="*" />
            <!-- 底部工业通讯状态监视栏 -->
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ui:Button Margin="4,0"
                               ToolTip="切换深浅主题"
                               Command="{Binding ToggleThemeCommand}"
                               Icon="{ui:SymbolIcon DarkTheme24}"
                               Background="{x:Null}"
                               BorderThickness="0"
                               CornerRadius="4" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 中部主体：导航栏与主展示区 -->
        <Grid Grid.Row="1" Margin="8,4,8,4">
            <ui:NavigationView x:Name="RootNavigation"
                               OpenPaneLength="220"
                               CompactPaneLength="52"
                               TransitionDuration="200"
                               Transition="FadeInWithSlide"
                               Padding="6">
                <ui:NavigationView.Sidebar>
                    <ui:SidebarMenu ItemsSource="{Binding NavigationItems}"
                                    Title="功能导航"
                                    Width="210"
                                    BorderThickness="0"
                                    Padding="10,0,10,0" />
                </ui:NavigationView.Sidebar>
            </ui:NavigationView>

            <!-- 浮动通知与对话框宿主 -->
            <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
            <ContentPresenter x:Name="RootContentDialog" MinHeight="400" />
        </Grid>

        <!-- 底部工业通讯状态监视栏 -->
        <Border Grid.Row="2"
                Background="{ui:ThemeResource ControlFillSecondaryColorBrush}"
                BorderBrush="{ui:ThemeResource ControlBorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- 通讯状态指示 -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <!-- 通讯类型与链路 -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <!-- 收发流量统计 -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <!-- 错误计数 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 弹性空白 -->
                    <ColumnDefinition Width="*" />
                    <!-- 设备信息/状态描述 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. 连接状态指示灯与文字 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#8A8A8A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#107C41" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <ui:TextBlock Text="{Binding ConnectionStateText}" FontTypography="Caption" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 分割线 -->
                <Separator Grid.Column="1" Margin="4" Style="{x:Null}" />

                <!-- 2. 通讯链路类型 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Connector20" Margin="0,0,6,0" FontSize="14" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                    <ui:TextBlock Text="{Binding CommunicationType}" FontTypography="Caption" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 分割线 -->
                <Separator Grid.Column="3" Margin="4" Style="{x:Null}" />

                <!-- 3. 收发流量统计 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="TX: " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" FontTypography="Caption" />
                    <ui:TextBlock Text="{Binding TxBytes}" FontTypography="Caption" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <ui:TextBlock Text="RX: " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" FontTypography="Caption" />
                    <ui:TextBlock Text="{Binding RxBytes}" FontTypography="Caption" FontWeight="SemiBold" />
                </StackPanel>

                <!-- 分割线 -->
                <Separator Grid.Column="5" Margin="4" Style="{x:Null}" />

                <!-- 4. 通讯异常错误计数 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBlock Text="错误: " Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" FontTypography="Caption" />
                    <ui:TextBlock Text="{Binding ErrorCount}" FontTypography="Caption" FontWeight="SemiBold">
                        <ui:TextBlock.Style>
                            <Style TargetType="ui:TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorCount, Converter={x:Null}}" Value="0">
                                        <Setter Property="Foreground" Value="{ui:ThemeResource ApplicationTextColorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                </StackPanel>

                <!-- 5. 当前设备状态信息 -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Desktop20" Margin="0,0,6,0" FontSize="14" Foreground="{ui:ThemeResource ControlTextSecondaryColorBrush}" />
                    <ui:TextBlock Text="{Binding DeviceInfo}" FontTypography="Caption" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
