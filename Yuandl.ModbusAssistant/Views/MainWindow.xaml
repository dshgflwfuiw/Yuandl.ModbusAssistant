<Window x:Class="Yuandl.ModbusAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Yuandl.ModbusAssistant.Controls"
        Title="Yuandl.ModbusAssistant — 工业协议与 Modbus 调试工作站 (.NET 8 WPF)"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Main Workspace with Left Navigation Rail -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    TabStripPlacement="Left"
                    Background="{DynamicResource BgCanvasBrush}"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabControl">
                    <Setter Property="TabStripPlacement" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabControl">
                                <Grid Background="{TemplateBinding Background}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NavigationWidthConverter}}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource BgSidebarBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,0,1,0">
                                        <Grid Margin="14,20,14,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="4,0,4,24">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,24">
                                                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="M" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Margin="48,0,38,0"
                                                                Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="YUANDL" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="MODBUS WORKBENCH" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Width="30" Height="30" Padding="0"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding ToggleNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="收起左侧菜单">
                                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                                <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                        Width="30" Height="30" Padding="0" Margin="0,-16,0,8"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"
                                                        Command="{Binding ToggleNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="展开左侧菜单">
                                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                </Button>
                                                <TextBlock Grid.Row="1" Text="工作区" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,8"
                                                           Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                                            </ScrollViewer>
                                            <Border Grid.Row="2" Background="{DynamicResource BgSurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="2,14,2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="协议工作站" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource BgCanvasBrush}" ClipToBounds="True">
                                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="True" />
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="11,10" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="MinWidth" Value="188" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="0,2"
                                        CornerRadius="8">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgNavHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgNavSelectedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- 1. 通讯连接 & Modbus 服务器 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="通讯连接 &amp; 服务器" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel DataContext="{Binding Connection}">
                        <!-- Client / Transport Channel Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="通讯通道配置 (串口 / TCP 客户端 / UDP / 无协议 TCP 服务端)" />
                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Width="200" Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="通道类型" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}"
                                                  ItemsSource="{Binding CommunicationTypes}"
                                                  SelectedItem="{Binding SelectedType}"
                                                  Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="连接 / 启动"
                                                Command="{Binding ConnectCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="断开 / 停止"
                                                Command="{Binding DisconnectCommand}"
                                                Margin="0,0,12,0" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding ChannelState, StringFormat='状态: {0}'}" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Serial Parameters -->
                                <WrapPanel Visibility="{Binding IsSerialSelected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Width="150" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="串口号 (支持同口环回仿真)" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshPortsCommand}" Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="4,0,0,0" />
                                            <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding Serial.PortName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="False" Padding="6,4" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="波特率" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding Serial.BaudRate}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="85" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="数据位" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding Serial.DataBits}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="校验位" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Serial.Parity}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="停止位" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding Serial.StopBits}" Padding="6,4" />
                                    </StackPanel>
                                    <CheckBox Content="DTR" IsChecked="{Binding Serial.DtrEnable}" VerticalAlignment="Bottom" Margin="4,0,10,12" />
                                    <CheckBox Content="RTS" IsChecked="{Binding Serial.RtsEnable}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                                </WrapPanel>

                                <!-- TCP Client Parameters -->
                                <WrapPanel Visibility="{Binding IsTcpClientSelected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Width="180" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="目标主机 IP / 域名" />
                                        <TextBox Text="{Binding TcpClient.Host}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="端口" />
                                        <TextBox Text="{Binding TcpClient.Port}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="连接超时 (ms)" />
                                        <TextBox Text="{Binding TcpClient.ConnectTimeoutMs}" Padding="6,4" />
                                    </StackPanel>
                                    <CheckBox Content="断线自动重连" IsChecked="{Binding TcpClient.AutoReconnect}" VerticalAlignment="Bottom" Margin="6,0,0,12" />
                                </WrapPanel>

                                <!-- UDP Parameters -->
                                <WrapPanel Visibility="{Binding IsUdpSelected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Width="180" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="远端主机" />
                                        <TextBox Text="{Binding Udp.RemoteHost}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="远端端口" />
                                        <TextBox Text="{Binding Udp.RemotePort}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="本地端口 (0=自动)" />
                                        <TextBox Text="{Binding Udp.LocalPort}" Padding="6,4" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- TCP Server Parameters + Connected Clients -->
                                <StackPanel Visibility="{Binding IsTcpServerSelected, Converter={StaticResource BoolToVis}}">
                                    <WrapPanel Margin="0,0,0,8">
                                        <StackPanel Width="150" Margin="0,0,12,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="本地监听端口" />
                                            <TextBox Text="{Binding TcpServer.ListenPort}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Width="360" Margin="0,0,12,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="本机 IP:端口" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshLocalIpAddressesCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="6,0,0,0" />
                                                <TextBlock Text="{Binding LocalIpAddressesText}" VerticalAlignment="Center" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalIpAddressesText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                            </DockPanel>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding ServerClients.Count, StringFormat='已连接客户端会话 ({0})'}" />
                                    <DataGrid ItemsSource="{Binding ServerClients}" AutoGenerateColumns="False" IsReadOnly="True" Height="120" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="会话ID" Binding="{Binding SessionId}" Width="80" />
                                            <DataGridTextColumn Header="远端地址" Binding="{Binding RemoteAddress}" Width="140" />
                                            <DataGridTextColumn Header="端口" Binding="{Binding RemotePort}" Width="80" />
                                            <DataGridTextColumn Header="接入时间" Binding="{Binding ConnectedAtText}" Width="95" />
                                            <DataGridTextColumn Header="已发 (B)" Binding="{Binding BytesSent}" Width="90" />
                                            <DataGridTextColumn Header="已收 (B)" Binding="{Binding BytesReceived}" Width="90" />
                                            <DataGridTemplateColumn Header="操作" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="断开"
                                                                Command="{Binding DataContext.KickClientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <TextBlock Text="{Binding ConnectionError}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Built-in Modbus Slave Server Card -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="导入 JSON" Command="{Binding ImportConfigCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="导出 JSON" Command="{Binding ExportConfigCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="重置初始值" Command="{Binding ResetRegistersCommand}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="内置 Modbus 从站服务器 (TCP / 串口 RTU / 串口 ASCII / 双通道 + 在线改值)" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>

                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Width="155" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="服务器传输模式" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ServerTransportModes}" SelectedItem="{Binding ServerMode}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="80" Margin="0,0,10,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="从站站号" />
                                        <TextBox Text="{Binding ServerStation}" Padding="6,4" />
                                    </StackPanel>
                                    <StackPanel Width="95" Margin="0,0,10,8" Visibility="{Binding ServerUsesTcp, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TCP 端口" />
                                        <TextBox Text="{Binding ServerPort}" Padding="6,4" />
                                    </StackPanel>
                                    <WrapPanel Visibility="{Binding ServerUsesSerial, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="115" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="服务器串口" />
                                            <ComboBox ItemsSource="{Binding AvailablePorts}" Text="{Binding ServerSerial.PortName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="False" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Width="95" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="波特率" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding ServerSerial.BaudRate}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Width="70" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="数据位" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding ServerSerial.DataBits}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Width="90" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="校验位" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding ServerSerial.Parity}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Width="95" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="停止位" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding ServerSerial.StopBits}" Padding="6,4" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                        <Button Style="{StaticResource PrimaryButton}" Content="启动服务器" Command="{Binding StartServerCommand}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource DangerButton}" Content="停止服务器" Command="{Binding StopServerCommand}" />
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Text="{Binding ServerStatusText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <!-- Add Register Definition Row -->
                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Width="190" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="存储区" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding RegisterAreas}" SelectedItem="{Binding NewArea}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="75" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="地址" />
                                        <TextBox Text="{Binding NewAddress}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="数据类型" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding RegisterDataTypes}" SelectedItem="{Binding NewDataType}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="字节序" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding RegisterByteOrders}" SelectedItem="{Binding NewByteOrder}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="初始值" />
                                        <TextBox Text="{Binding NewInitialValue}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="备注" />
                                        <TextBox Text="{Binding NewNote}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="70" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="批量数量" />
                                        <TextBox Text="{Binding NewRegisterCount, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="+ 添加数据定义" Command="{Binding AddRegisterCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="批量添加" Command="{Binding AddRegisterBatchCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                </WrapPanel>

                                <!-- Server Register Table with Online Runtime Value Editing -->
                                <DataGrid ItemsSource="{Binding ServerRegisters}" AutoGenerateColumns="False" CanUserAddRows="False" Height="230" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="存储区" Binding="{Binding Area}" IsReadOnly="True" Width="130" />
                                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" IsReadOnly="True" Width="70" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding DataType}" IsReadOnly="True" Width="85" />
                                        <DataGridTextColumn Header="字节序" Binding="{Binding ByteOrder}" IsReadOnly="True" Width="95" />
                                        <DataGridTextColumn Header="初始值" Binding="{Binding InitialValue}" IsReadOnly="True" Width="85" />
                                        <DataGridTemplateColumn Header="实时值 (在线改值：按 Enter 或点击写入 / 位切换)" Width="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2">
                                                        <!-- 位类型：一键切换 -->
                                                        <Button Content="{Binding BitDisplayText}"
                                                                Padding="8,3"
                                                                Visibility="{Binding IsBit, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.ToggleBitRuntimeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" />
                                                        <!-- 数值类型：在线编辑 + Enter / 写入按钮 -->
                                                        <DockPanel Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVis}}">
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="写入"
                                                                    Padding="8,2"
                                                                    Margin="4,0,0,0"
                                                                    Command="{Binding DataContext.ApplyRuntimeValueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBox Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Padding="4,2">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter"
                                                                                Command="{Binding DataContext.ApplyRuntimeValueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}" />
                                                                </TextBox.InputBindings>
                                                            </TextBox>
                                                        </DockPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" IsReadOnly="True" Width="*" />
                                        <DataGridTemplateColumn Header="操作" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="删除"
                                                            Padding="6,2"
                                                            Command="{Binding DataContext.DeleteRegisterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{Binding ServerBanner}" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Modbus 调试 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Modbus 调试" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12" DataContext="{Binding ModbusDebug}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Modbus 主站请求构造与执行 (FC 01 - 10，支持 0F/10 批量写入)" />
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Width="110" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="协议格式" />
                                    <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="站号 (Unit)" />
                                    <TextBox Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="270" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="功能码 (Function Code)" />
                                    <ComboBox ItemsSource="{Binding Functions}"
                                              SelectedItem="{Binding SelectedFunction}"
                                              DisplayMemberPath="Label"
                                              Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="起始地址" />
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="185" Margin="0,0,10,8" Visibility="{Binding IsReadOrSingle, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding QuantityOrValueLabel}" />
                                    <TextBox Text="{Binding QuantityOrValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="95" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="超时 (ms)" />
                                    <TextBox Text="{Binding TimeoutMs}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Button Style="{StaticResource SecondaryButton}" Content="生成请求" Command="{Binding BuildPreviewCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="发送请求" Command="{Binding ExecuteCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="解析响应" Command="{Binding ParseManualResponseCommand}" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- 0F / 10 Batch Multi-Value Editor -->
                            <Border Visibility="{Binding IsBatchWrite, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource BgSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BatchParsedStatus}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding BatchListHint}" FontSize="12" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <TextBox Text="{Binding BatchValuesText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="54"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             Padding="6,4" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="请求报文 (HEX)" />
                                    <TextBox Text="{Binding RequestPreviewHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="响应报文 (HEX)" />
                                    <TextBox Text="{Binding ResponseHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="6,4" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="解码数据表" />
                            <DataGrid ItemsSource="{Binding DecodedItems}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="寄存器/线圈地址" Binding="{Binding Address}" Width="140" />
                                    <DataGridTextColumn Header="十六进制 (HEX)" Binding="{Binding HexValue}" Width="160" />
                                    <DataGridTextColumn Header="无符号整数 / Bit" Binding="{Binding DecimalValue}" Width="160" />
                                    <DataGridTextColumn Header="有符号 (Int16) / 布尔状态" Binding="{Binding SignedOrBool}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. 原始报文调试 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C0;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="原始报文" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12" DataContext="{Binding RawDebug}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountersText}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="无协议字节流 / 多客户端定向收发" Margin="0" />
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Width="105" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="发送编码" />
                                    <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding Encodings}" SelectedItem="{Binding SendEncoding}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="105" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="接收编码" />
                                    <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding Encodings}" SelectedItem="{Binding ReceiveEncoding}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="105" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="追加结束符" />
                                    <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding Delimiters}" SelectedItem="{Binding Delimiter}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="230" Margin="0,0,10,8" Visibility="{Binding IsTcpServerMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="目标 TCP 客户端" />
                                    <ComboBox ItemsSource="{Binding TcpClients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="DisplayLabel" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="发送历史" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearHistoryCommand}" Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="4,0,0,0" />
                                        <ComboBox ItemsSource="{Binding SendHistory}" SelectedItem="{Binding SelectedHistoryItem}" Padding="6,4" />
                                    </DockPanel>
                                </StackPanel>
                                <CheckBox Content="暂停接收" IsChecked="{Binding IsPauseReceive}" VerticalAlignment="Bottom" Margin="4,0,12,12" />
                                <CheckBox Content="定时发送" IsChecked="{Binding IsLoopSend}" VerticalAlignment="Bottom" Margin="0,0,6,12" />
                                <StackPanel Width="75" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="间隔(ms)" />
                                    <TextBox Text="{Binding LoopIntervalMs}" Padding="5,4" />
                                </StackPanel>
                            </WrapPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="发送数据" Command="{Binding SendCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="清空记录" Command="{Binding ClearCommand}" />
                                </StackPanel>
                                <TextBox Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="8,6" />
                            </DockPanel>
                            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="实时收发历史" />
                            <DataGrid ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="105" />
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="65" />
                                    <DataGridTextColumn Header="字节数" Binding="{Binding ByteLength}" Width="65" />
                                    <DataGridTextColumn Header="会话" Binding="{Binding SessionLabel}" Width="160" />
                                    <DataGridTextColumn Header="报文内容" Binding="{Binding Content}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 4. 数据监听 & 示波器 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="数据监听 &amp; 示波器" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12" DataContext="{Binding RegisterMonitor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="262" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="0" MaxHeight="250" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding SampleOnceLabel}" Command="{Binding SampleOnceCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="开始监听" Command="{Binding StartCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource DangerButton}" Content="停止监听" Command="{Binding StopCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="冻结/恢复" Command="{Binding ToggleFreezeCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="清空波形" Command="{Binding ClearScopeCommand}" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="导出 CSV" Command="{Binding ExportCsvCommand}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="多通道实时数据监听与示波器中心 (支持 Bool 布尔方波 / Float / Double)" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Width="170" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="采集组" />
                                        <ComboBox ItemsSource="{Binding PollingGroups}" SelectedItem="{Binding SelectedPollingGroup}" Padding="5,4">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,3">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding LastStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="145" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="组名称" />
                                        <TextBox Text="{Binding SelectedPollingGroup.Name, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="＋ 添加采集组" Command="{Binding AddPollingGroupCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="删除当前组" Command="{Binding RemovePollingGroupCommand}" VerticalAlignment="Bottom" Margin="0,0,12,6" />
                                    <CheckBox Content="启用此组" IsChecked="{Binding SelectedPollingGroup.IsEnabled}" IsEnabled="{Binding IsPollingMode}" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                                </WrapPanel>

                                <WrapPanel>
                                    <StackPanel Width="145" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="数据源" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding DataSources}" SelectedItem="{Binding DataSource}" Padding="5,4" />
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="视图布局" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ViewLayouts}" SelectedItem="{Binding ViewLayout}" Padding="5,4" />
                                    </StackPanel>
                                    <WrapPanel Visibility="{Binding IsPollingMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="80" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="协议" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport}" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="60" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="站号" />
                                            <TextBox Text="{Binding UnitId}" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="65" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="功能码" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ReadFunctions}" SelectedItem="{Binding FunctionCode}" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="70" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="起始地址" />
                                            <TextBox Text="{Binding StartAddress}" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="90" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="数量（位/寄存器）" />
                                            <TextBox Text="{Binding Quantity}" Padding="5,4" />
                                        </StackPanel>
                                        <WrapPanel Visibility="{Binding IsRegisterFunction, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Width="88" Margin="0,0,8,6">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="数据类型" />
                                                <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}" Padding="5,4" />
                                            </StackPanel>
                                            <StackPanel Width="90" Margin="0,0,8,6">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="字节序" />
                                                <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding ByteOrder}" Padding="5,4" />
                                            </StackPanel>
                                            <StackPanel Width="65" Margin="0,0,8,6">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="缩放" />
                                                <TextBox Text="{Binding Scale}" Padding="5,4" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </WrapPanel>
                                    <StackPanel Width="80" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="本组周期(ms)" />
                                        <TextBox Text="{Binding IntervalMs}" Padding="5,4" />
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="＋ 添加数据到当前组" Command="{Binding AddPollingDataCommand}" IsEnabled="{Binding IsPollingMode}" VerticalAlignment="Bottom" Margin="0,0,12,6" />
                                    <StackPanel Width="80" Margin="0,0,8,6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="时窗(秒)" />
                                        <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding TimeWindows}" SelectedItem="{Binding TimeWindowSec}" Padding="5,4" />
                                    </StackPanel>
                                    <CheckBox Content="采样点" IsChecked="{Binding ShowMarkers}" VerticalAlignment="Bottom" Margin="4,0,10,10" />
                                    <CheckBox Content="自动 Y 轴" IsChecked="{Binding AutoScaleY}" VerticalAlignment="Bottom" Margin="0,0,8,10" />
                                    <WrapPanel Visibility="{Binding IsManualY, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="70" Margin="0,0,6,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Y Min" />
                                            <TextBox Text="{Binding ManualYMin, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="70" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Y Max" />
                                            <TextBox Text="{Binding ManualYMax, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <CheckBox Content="边沿触发" IsChecked="{Binding TriggerEnabled}" VerticalAlignment="Bottom" Margin="0,0,8,10" />
                                    <WrapPanel Visibility="{Binding TriggerEnabled, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Width="125" Margin="0,0,6,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="触发通道" />
                                            <ComboBox ItemsSource="{Binding ScopeChannels}" SelectedItem="{Binding TriggerChannel}" DisplayMemberPath="Label" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="85" Margin="0,0,6,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="边沿" />
                                            <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding TriggerEdges}" SelectedItem="{Binding TriggerEdge}" Padding="5,4" />
                                        </StackPanel>
                                        <StackPanel Width="75" Margin="0,0,8,6">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="触发电平" />
                                            <TextBox Text="{Binding TriggerLevel, UpdateSourceTrigger=PropertyChanged}" Padding="5,4" />
                                        </StackPanel>
                                    </WrapPanel>
                                </WrapPanel>
                                <DockPanel Margin="0,0,0,6" Visibility="{Binding IsPollingMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Left" Text="当前组数据" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedPollingGroup.DataItems.Count, StringFormat='共 {0} 项'}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding SelectedPollingGroup.DataItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BgSurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,6,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <Button Content="×" Padding="5,0" MinHeight="22" Command="{Binding DataContext.RemovePollingDataCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="从当前组移除此数据" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Oscilloscope + Channel Legend + Live Value Table -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding ScopeRowHeight}" />
                            <RowDefinition Height="{Binding ScopeTableSplitterHeight}" />
                            <RowDefinition Height="{Binding TableRowHeight}" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CardBorder}"
                                Margin="0"
                                Padding="8"
                                MinHeight="250"
                                Visibility="{Binding ShowScope, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <!-- Clickable Channel Telemetry Legend Strip -->
                                <ScrollViewer DockPanel.Dock="Top" MaxHeight="66" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                                    <ItemsControl ItemsSource="{Binding ScopeChannels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,6"
                                                    Padding="8,4"
                                                    Cursor="Hand"
                                                    Background="{DynamicResource BgSurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.ToggleChannelScopeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding LatestText}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding RangeText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <controls:OscilloscopeControl ViewModel="{Binding}" />
                                </Border>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource CardBorder}"
                                Margin="0"
                                Visibility="{Binding ShowTable, Converter={StaticResource BoolToVis}}">
                            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="曲线" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ScopeToggleText}"
                                                        Padding="6,2"
                                                        Background="{Binding TraceColorHex, Converter={StaticResource HexToBrush}}"
                                                    Foreground="{Binding TraceColorHex, Converter={StaticResource HexToContrastBrush}}"
                                                    FontWeight="SemiBold"
                                                    BorderBrush="#334155"
                                                    BorderThickness="1"
                                                        Command="{Binding DataContext.ToggleChannelScopeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="通道标识" Binding="{Binding Label}" IsReadOnly="True" Width="120" />
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" IsReadOnly="True" Width="75" />
                                    <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" IsReadOnly="True" Width="140" />
                                    <DataGridTextColumn Header="当前显示值" Binding="{Binding DisplayValue}" IsReadOnly="True" Width="140" />
                                    <DataGridTextColumn Header="数字量(Bool)" Binding="{Binding IsDigital}" IsReadOnly="True" Width="90" />
                                    <DataGridTextColumn Header="备注 (可双击编辑)" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 5. 报文分析 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="报文分析" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12" DataContext="{Binding PacketAnalysis}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="实时捕获收发流量" IsChecked="{Binding IsCapturing}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding CaptureTransport}" Width="95" Margin="0,0,10,0" Padding="5,4" />
                                <Button Style="{StaticResource SecondaryButton}" Content="清空统计" Command="{Binding ClearCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Modbus 报文流量实时捕获与往返时延 (RTT) 分析" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <TextBlock Text="{Binding TotalPackets, StringFormat='总报文: {0}   '}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ErrorPackets, StringFormat='异常帧: {0}   '}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MatchedPairs, StringFormat='匹配问答对: {0}   '}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RttStatsSummary}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="1">
                        <DataGrid ItemsSource="{Binding CapturedPackets}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="105" />
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="60" />
                                <DataGridTextColumn Header="协议" Binding="{Binding Transport}" Width="70" />
                                <DataGridTextColumn Header="RTT 时延" Binding="{Binding RttText}" Width="85" />
                                <DataGridTextColumn Header="原始 HEX" Binding="{Binding Hex}" Width="260" />
                                <DataGridTextColumn Header="解析结论" Binding="{Binding Result}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="2" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="离线手动解析 HEX 报文" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding ManualTransports}" SelectedItem="{Binding ManualTransport}" Width="90" Margin="0,0,8,0" Padding="5,4" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="手动解析" Command="{Binding ParseManualCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding ManualHexInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="6,4" />
                            </DockPanel>
                            <TextBlock Text="{Binding ManualResultText}" Margin="0,6,0,0" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 6. 设备配置管理 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="设备管理" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12" DataContext="{Binding DeviceManagement}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="设备连接配置集 (本地持久化)" />
                            <WrapPanel>
                                <StackPanel Width="180" Margin="0,0,10,6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="设备名称" />
                                    <TextBox Text="{Binding Name}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="协议类型" />
                                    <ComboBox Style="{StaticResource LocalizedComboBoxStyle}" ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="200" Margin="0,0,10,6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="通讯端点 (IP:Port / COM)" />
                                    <TextBox Text="{Binding Endpoint}" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="默认站号" />
                                    <TextBox Text="{Binding StationId}" Padding="6,4" />
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="+ 保存设备方案" Command="{Binding AddProfileCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Margin="0">
                        <DataGrid ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="140" />
                                <DataGridTextColumn Header="端点" Binding="{Binding Endpoint}" Width="*" />
                                <DataGridTextColumn Header="站号" Binding="{Binding StationId}" Width="80" />
                                <DataGridTemplateColumn Header="操作" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删除"
                                                    Padding="6,2"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 7. 系统设置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="系统设置" VerticalAlignment="Center" Visibility="{Binding IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,24" DataContext="{Binding Settings}" MaxWidth="1040" HorizontalAlignment="Stretch">
                        <TextBlock Text="系统设置" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
                        <TextBlock Text="管理界面外观和 Modbus 通讯默认行为" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource BgNavSelectedBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="应用主题" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="即时切换浅色与深色工作环境" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Background="{DynamicResource BgSurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                            <CheckBox Content="启用深色模式" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="主题会立即应用并自动保存，无需重启程序。" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,9,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="通讯默认值" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Modbus 请求策略" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="用于调试和监听请求的默认等待与重试设置。" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,14" TextWrapping="Wrap" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="响应超时" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="等待设备响应的最长时间" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding DefaultTimeoutMs, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="毫秒" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="失败重试次数" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="请求失败后的自动重试次数" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding DefaultRetryTimes, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="次" />
                                        </Grid>

                                        <Button Style="{StaticResource PrimaryButton}" Content="保存通讯设置" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding SaveBanner}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,8" />
                        <Border Style="{StaticResource CardBorder}" Padding="16,13" Margin="0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="M" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Yuandl Modbus Assistant" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Yuandl Modbus Assistant v1.0.0

工业通讯与协议分析套件（支持串口仿真、TCP/UDP 通讯、Modbus 帧编解码与内置 Modbus TCP 服务器）" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Text="串口 · TCP/UDP · Modbus" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Industrial Telemetry Status Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding TrafficSummary}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusSummary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding ServerBadgeText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding LastAlert}" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
